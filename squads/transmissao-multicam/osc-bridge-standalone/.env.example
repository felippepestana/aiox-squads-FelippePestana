# ── OSC bridge ─────────────────────────────────────────
# UDP port the bridge listens on (TouchOSC tablet sends commands here).
OSC_PORT=9300

# Where the bridge sends feedback. Point this at the IP of the tablet
# running TouchOSC and the port TouchOSC is listening on.
OSC_FEEDBACK_HOST=127.0.0.1
OSC_FEEDBACK_PORT=9301

# ── OBS WebSocket ──────────────────────────────────────
# The bridge connects to OBS as a regular obs-websocket v5 client.
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
# Server-only — leave empty if obs-websocket has no password set.
OSC_OBS_PASSWORD=

# ── Config files ──────────────────────────────────────
# Path resolution order: env var → relative to dist/index.js → repo squad data/
# These default to the squad's `data/` directory two levels up.
MIC_MAPPING_PATH=../../data/mic-mapping.yaml
OSC_MAPPING_PATH=../../data/osc-mapping.yaml
