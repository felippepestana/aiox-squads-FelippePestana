# Copie para .env na pasta web/ (não commite .env)
# Obtenha sua chave em: https://console.anthropic.com/settings/keys
# Formato esperado: começa com `sk-ant-`
ANTHROPIC_API_KEY=

# Opcional: se definida, todas as rotas /api/* (exceto health e auth/status)
# exigem header X-Portal-Key ou Authorization: Bearer <valor>.
# A UI pede a chave uma vez e guarda em sessionStorage.
# WEB_PORTAL_API_KEY=

# Opcional: pasta de squads (padrão: ../squads em relação a web/)
# SQUADS_ROOT=C:\caminho\para\aiox-squads-FelippePestana\squads

# Porta da API (padrão 8787)
# PORT=8787

# CORS: lista separada por vírgulas, ou vazio para permitir qualquer origem (útil só em dev)
# CORS_ORIGIN=http://127.0.0.1:5173

# Trust proxy (1 = atrás de reverse proxy em produção)
# TRUST_PROXY=0

# Rate limit (por IP). Desative com RATE_LIMIT_ENABLED=0
# RATE_LIMIT_MAX=200
# RATE_LIMIT_HEAVY_MAX=30
# RATE_LIMIT_ENABLED=1

# Sentry: DSN do projeto Node (servidor). Build de produção do cliente usa VITE_SENTRY_DSN no .env.production.
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (talent-compass / Apex-Talent) — persistência OPCIONAL.
# Se não definidas, a feature de entrevista funciona normalmente, apenas sem gravar
# no banco (persistência best-effort). NUNCA commite a service-role key.
# URL do projeto (ex.: https://hlwdnwqcctslwjlzhfsz.supabase.co)
# SUPABASE_URL=
# Chave service-role (SECRETA, somente servidor). Obtenha em Settings > API.
# SUPABASE_SERVICE_ROLE_KEY=
# Chave anon/publishable (cliente). Opcional para esta feature.
# SUPABASE_ANON_KEY=
