# Provedor de IA (geração de documentos). Sem a chave, o app roda em modo "rascunho do template".
ANTHROPIC_API_KEY=
# Modelo Claude (padrão: claude-sonnet-4-6). Para máxima capacidade: claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-4-6

# Identificação do município (caso de referência: Porto Velho/RO)
NEXT_PUBLIC_MUNICIPIO_NOME=Porto Velho
NEXT_PUBLIC_MUNICIPIO_UF=RO
NEXT_PUBLIC_MUNICIPIO_IBGE=1100205

# As APIs públicas (PNCP, SICONFI, IBGE) não exigem credencial.

# Persistência e autenticação (Supabase). Sem estas variáveis, o app roda sem
# persistência: a geração de documentos continua funcionando, mas não há login
# nem salvamento de artefatos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Provedor de login gov.br (OIDC) configurado como provider externo no Supabase Auth
# (roadmap). Enquanto não habilitado, o login usa magic link por e-mail.
