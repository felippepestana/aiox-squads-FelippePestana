# Supabase (autenticação — OPCIONAL)
# Defina AMBOS NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY para
# habilitar login real: o middleware protege /dashboard, as rotas de API exigem
# sessão e as análises são atribuídas ao usuário autenticado.
# Se deixados em branco, o app roda em "modo demo" (sem login, perfil demo).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Direct connection for migrations)
# Supabase:
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Local (docker compose up -d):
# DATABASE_URL=postgresql://analista:analista@localhost:5432/analista_processual

# Redis (fila BullMQ — OPCIONAL)
# Se definido, a rota /process enfileira e um worker dedicado (`npm run worker`)
# processa a análise. Sem REDIS_URL, o processamento roda inline na request.
REDIS_URL=redis://localhost:6379
# Concorrência do worker (padrão 2)
WORKER_CONCURRENCY=2

# LLM Providers — defina A CHAVE DE PELO MENOS UM provedor.
# Todos são compatíveis com a API OpenAI. Para a maioria dos provedores a
# *_BASE_URL já tem um padrão embutido — basta definir a *_API_KEY.
# Opcionalmente, sobrescreva o modelo real com <PROVIDER>_MODEL.

# OpenAI (padrão)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek — barato e de alta qualidade (base URL embutida)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# Groq — tier gratuito, muito rápido (Llama 3.3 70B)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — tier gratuito (endpoint compatível com OpenAI)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# Mistral — Mistral Large / Small (base URL embutida)
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-large-latest

# xAI (Grok) — Grok 3 / Grok 3 Mini (base URL embutida)
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-3

# OpenRouter — uma chave, centenas de modelos
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Demais compatíveis (base URL embutida; descomente para usar)
# QWEN_API_KEY=sk-...          # Qwen 2.5 (DashScope)
# KIMI_API_KEY=sk-...          # Kimi K2 (Moonshot)
# MINIMAX_API_KEY=sk-...       # MiniMax 01

# Provedor genérico (qualquer endpoint compatível com OpenAI):
# Together, Fireworks, Cerebras, Ollama/vLLM/LM Studio local, etc.
# CUSTOM_API_KEY=...
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL=llama3.1            # obrigatório ao usar o provedor custom
# CUSTOM_TIER=standard             # budget | standard | premium

# OCR (imagens e PDFs escaneados) — OPCIONAL
# Idiomas do tesseract.js (baixados sob demanda na 1ª execução).
OCR_LANGS=por+eng
# Diretório de cache dos dados de idioma (recomendado em serverless: /tmp).
OCR_CACHE_PATH=/tmp/tesseract
# Limite de páginas a fazer OCR em PDFs escaneados (protege o tempo da request).
OCR_PDF_MAX_PAGES=20
# Escala de rasterização das páginas do PDF antes do OCR (maior = mais nítido/lento).
OCR_PDF_SCALE=2

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# Storage
STORAGE_BUCKET=documents
