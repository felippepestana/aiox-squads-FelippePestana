# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Direct connection for migrations)
# Supabase:
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Local (docker compose up -d):
# DATABASE_URL=postgresql://analista:analista@localhost:5432/analista_processual

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# LLM Provider API Keys
# At least OPENAI_API_KEY is required to run the multi-agent analysis pipeline.
# The other providers are OpenAI-compatible and are only enabled when BOTH the
# API key AND the corresponding *_BASE_URL are set.
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.cn/v1
MINIMAX_API_KEY=sk-...
MINIMAX_BASE_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# Storage
STORAGE_BUCKET=documents
